# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CORE SYSTEM CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SCHOOL IDENTITY — Set these per school
# The system shows ONLY the school's own 
# name and branding everywhere
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NEXT_PUBLIC_SCHOOL_NAME=Greenfield Academy
NEXT_PUBLIC_SCHOOL_TAGLINE=Excellence in Education
NEXT_PUBLIC_SCHOOL_LOGO_URL=
NEXT_PUBLIC_SCHOOL_PRIMARY_COLOR=#1e3a5f
NEXT_PUBLIC_SCHOOL_ACCENT_COLOR=#16a34a
NEXT_PUBLIC_SCHOOL_PHONE=+233244123456
NEXT_PUBLIC_SCHOOL_EMAIL=info@school.edu.gh
NEXT_PUBLIC_SCHOOL_ADDRESS=123 Education Road, Accra
NEXT_PUBLIC_SCHOOL_WHATSAPP=+233244123456
NEXT_PUBLIC_SCHOOL_COUNTRY=Ghana

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OPTIONAL INTEGRATIONS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Twilio for SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend for Email
RESEND_API_KEY=

# Cloudinary for Image Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis for Rate Limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

CRON_SECRET=

NODE_ENV=development
